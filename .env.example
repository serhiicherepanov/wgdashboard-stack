# --- Compose ---
# Remove docker-compose.traefik.yaml to run without the reverse proxy.
COMPOSE_FILE=docker-compose.yaml:docker-compose.traefik.yaml

# --- Traefik / ACME (HTTP-01 challenge on :80) ---
ACME_EMAIL=you@example.com
TRAEFIK_LOG_LEVEL=INFO
# htpasswd format, escape $ as $$ if using bcrypt/md5
TRAEFIK_DASHBOARD_USERS=admin:{SHA}xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WireGuard ---
TZ=Asia/Tbilisi
# Endpoint for client configs and the Traefik Host() rule.
WG_HOST=wg.example.com
# Published UDP port. Must match ListenPort in wgdashboard/conf/wg0.conf
# (the image template uses 51820; change it in the dashboard under
# Configuration Settings -> Edit Raw Configuration File, then update this).
WG_PORT=51820

# --- WGDashboard ---
WGD_TAG=latest
# UI bind without traefik (localhost only by default)
WGD_BIND=127.0.0.1
WGD_PORT=10086
# Default DNS pushed to peers
WGD_GLOBAL_DNS=9.9.9.9
# Interface(s) to start with the container
WGD_AUTOSTART=wg0
# Initial admin account; leave empty to use the first-run wizard.
# Non-empty values are re-applied on every container start.
WGD_USERNAME=
WGD_PASSWORD=
# true/false; empty = leave as configured in the UI
WGD_ENABLE_TOTP=
